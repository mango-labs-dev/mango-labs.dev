---
import { site } from '~/site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/brand/mango-mark.png" alt="" class="brand-mark" width="26" height="26" aria-hidden="true" />
      <p class="footer-name">Mango Labs</p>
      <p class="footer-tag">{site.tagline}</p>
    </div>

    <div class="footer-cols">
      <div class="footer-col">
        <span class="col-head">Site</span>
        <a href="/apps">Apps</a>
        <a href="/about">About</a>
        <a href="/support">Support</a>
      </div>
      <div class="footer-col">
        <span class="col-head">Elsewhere</span>
        <a href={site.social.playStoreDeveloper} target="_blank" rel="noopener">Play Store</a>
      </div>
    </div>
  </div>

  <div class="footer-meta">
    <p>&copy; {year} {site.name}. Made with care in India.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    padding: 48px 5% 20px;
    flex-wrap: wrap;
    gap: 24px;
    font-size: 13.5px;
    color: var(--sub);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .brand-mark {
    width: 26px;
    height: 26px;
    display: block;
    margin-bottom: 2px;
  }

  .footer-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
    margin: 0;
  }

  .footer-tag {
    margin: 0;
    color: var(--sub);
  }

  .footer-cols {
    display: flex;
    gap: 64px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .col-head {
    font-weight: 700;
    color: var(--ink);
  }

  .footer-col a {
    color: var(--sub);
    transition: color 0.15s ease;
  }

  .footer-col a:hover {
    color: var(--mango-deep);
  }

  .footer-meta {
    padding: 16px 5% 32px;
    font-size: 12.5px;
    color: var(--sub);
  }

  .footer-meta p {
    margin: 0;
  }
</style>
