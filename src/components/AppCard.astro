---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  app: CollectionEntry<'apps'>;
}

const { app } = Astro.props;
const { name, tagline, category, status, icon, iconColors } = app.data;
const from = iconColors?.from ?? '#ff9f2a';
const to = iconColors?.to ?? '#b3430a';

const statusLabel =
  status === 'released' ? null :
  status === 'beta' ? 'Beta' :
  status === 'closed' ? 'Closed testing' :
  status === 'internal' ? 'Internal testing' :
  'Coming soon';

const tagText = statusLabel ? `${category} · ${statusLabel}` : category;
---

<a href={`/apps/${app.id}`} class="app-card">
  <div
    class="app-card-icon"
    style={icon ? undefined : `background: linear-gradient(135deg, ${from}, ${to});`}
    aria-hidden="true"
  >
    {icon && (
      <Image src={icon} alt="" width={260} height={150} loading="lazy" />
    )}
  </div>
  <div class="app-card-body">
    <span class="app-card-tag">{tagText}</span>
    <h4 class="app-card-name">{name}</h4>
    <p class="app-card-tagline">{tagline}</p>
  </div>
</a>

<style>
  .app-card {
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: var(--ink);
    transition: transform 0.18s ease;
  }

  .app-card:hover {
    transform: translateY(-2px);
  }

  .app-card-icon {
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .app-card-icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .app-card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .app-card-tag {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--sage);
    letter-spacing: 0.04em;
  }

  .app-card-name {
    margin: 0;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    font-size: 16px;
    color: var(--ink);
    line-height: 1.3;
  }

  .app-card-tagline {
    margin: 0;
    font-size: 13px;
    color: var(--sub);
    line-height: 1.45;
  }
</style>
