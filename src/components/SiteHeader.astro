---
import { Icon } from 'astro-icon/components';
import { site } from '~/site.config';

const pathname = new URL(Astro.request.url).pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---

<header class="site-header">
  <div class="container-page header-inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <img src="/brand/mango-mark.png" alt="" class="brand-mark" width="30" height="30" aria-hidden="true" />
      <span class="brand-word" aria-hidden="true"><span class="w-mango">Mango</span><span class="w-labs">Labs</span><span class="w-dev">.dev</span></span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a href="/apps" class="btn-nav-cta">Get the apps</a>
      <button
        class="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        data-theme-toggle
      >
        <Icon name="mdi:weather-sunny" class="icon-light" />
        <Icon name="mdi:weather-night" class="icon-dark" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(140%) blur(10px);
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-mark {
    width: 30px;
    height: 30px;
    display: block;
  }

  .brand-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .w-mango { color: var(--fg); }
  .w-labs { color: var(--secondary); }
  .w-dev { color: var(--fg-muted); }

  .site-nav {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn-nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    border: 2px solid var(--ink);
    background: var(--accent);
    color: var(--accent-fg);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 2px 2px 0 var(--ink);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
    white-space: nowrap;
  }

  .btn-nav-cta:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .btn-nav-cta:active {
    transform: translate(1px, 1px);
    box-shadow: 0 0 0 var(--ink);
  }

  @media (max-width: 639px) {
    .btn-nav-cta { display: none; }
  }

  .nav-link {
    padding: 0.5rem 0.9rem;
    border-radius: 9999px;
    color: var(--fg-muted);
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--fg);
    background: var(--bg-elevated);
  }

  .nav-link.active {
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 12%, transparent);
  }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .theme-toggle:hover {
    background: var(--bg-elevated);
    border-color: var(--fg-muted);
  }

  .theme-toggle :global(svg) {
    width: 18px;
    height: 18px;
  }

  .theme-toggle .icon-dark { display: none; }
  :global(.dark) .theme-toggle .icon-light { display: none; }
  :global(.dark) .theme-toggle .icon-dark { display: inline; }
</style>
