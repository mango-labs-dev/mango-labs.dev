---
import { site } from '~/site.config';

const pathname = new URL(Astro.request.url).pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---

<header class="site-header">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <img src="/brand/mango-mark.png" alt="" class="brand-mark" width="30" height="30" aria-hidden="true" />
      <span class="brand-word">Mango Labs</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <a href="/apps" class="btn btn-primary nav-cta">Get the apps</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(140%) blur(10px);
    background: color-mix(in oklch, var(--bg) 88%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 5%;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand-mark {
    width: 30px;
    height: 30px;
    display: block;
    flex-shrink: 0;
  }

  .brand-word {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .site-nav {
    display: flex;
    gap: 28px;
    font-weight: 700;
    font-size: 14px;
    margin: 0 auto;
  }

  .nav-link {
    color: var(--sub);
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--mango-deep);
  }

  .nav-cta {
    font-size: 14px;
    padding: 10px 20px;
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .nav-cta { display: none; }
    .site-nav { gap: 18px; margin: 0 0 0 auto; }
  }
</style>
