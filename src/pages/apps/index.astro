---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AppCard from '~/components/AppCard.astro';

const apps = await getCollection('apps');
const sorted = apps.sort((a, b) => a.data.order - b.data.order);

const released = sorted.filter((a) => a.data.status === 'released');
const testing = sorted.filter((a) =>
  ['beta', 'closed', 'internal'].includes(a.data.status)
);
const upcoming = sorted.filter((a) => a.data.status === 'upcoming');
---

<BaseLayout
  title="Apps"
  description="Every app Mango Labs has shipped — and the ones we're working on next."
>
  <section class="hero">
    <span class="eyebrow">The lineup</span>
    <h1 class="headline">Our apps.</h1>
    <p class="hero-sub">
      A small, growing collection. Some are shipping; some are warming up backstage.
      Each one started because we wanted to use it ourselves.
    </p>
  </section>

  {released.length > 0 && (
    <section class="apps-section">
      <div class="section-head">
        <h2 class="headline">Shipping</h2>
        <span class="count">{released.length}</span>
      </div>
      <p class="section-sub">
        Live and available for download. Polished, stable, and ready to use.
      </p>
      <div class="apps-grid apps-grid-narrow">
        {released.map((app) => <AppCard app={app} />)}
      </div>
    </section>
  )}

  {released.length > 0 && (testing.length > 0 || upcoming.length > 0) && (
    <div class="divider"></div>
  )}

  {testing.length > 0 && (
    <section class="apps-section">
      <div class="section-head">
        <h2 class="headline">In internal testing</h2>
        <span class="count">{testing.length}</span>
      </div>
      <p class="section-sub">
        Closed builds going out to a small group. Public release follows once the feedback settles.
      </p>
      <div class="apps-grid apps-grid-narrow">
        {testing.map((app) => <AppCard app={app} />)}
      </div>
    </section>
  )}

  {testing.length > 0 && upcoming.length > 0 && (
    <div class="divider"></div>
  )}

  {upcoming.length > 0 && (
    <section class="apps-section">
      <div class="section-head">
        <h2 class="headline">In the kitchen</h2>
        <span class="count">{upcoming.length}</span>
      </div>
      <p class="section-sub">
        In development. Pages exist so we can polish copy and design ahead of launch —
        Play Store links arrive as each one ships.
      </p>
      <div class="apps-grid">
        {upcoming.map((app) => <AppCard app={app} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding: 40px 5% 8px;
    max-width: 760px;
  }

  .hero .eyebrow {
    display: block;
    margin-bottom: 12px;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 64px);
    line-height: 1;
    margin: 10px 0 16px;
    letter-spacing: -0.01em;
  }

  .hero-sub {
    font-size: 17px;
    color: var(--sub);
    line-height: 1.6;
    max-width: 600px;
    margin: 0;
  }

  .apps-section {
    padding: 48px 5%;
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .section-head h2 {
    font-size: 26px;
    margin: 0;
  }

  .count {
    background: var(--sage);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    border-radius: 99px;
    padding: 4px 12px;
    font-family: 'Nunito', sans-serif;
  }

  .section-sub {
    color: var(--sub);
    font-size: 15px;
    max-width: 600px;
    margin: 8px 0 28px;
    line-height: 1.55;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }

  .apps-grid-narrow {
    grid-template-columns: repeat(auto-fill, minmax(240px, 320px));
  }

  .divider {
    border-top: 1px solid var(--line);
    margin: 0 5%;
  }
</style>
