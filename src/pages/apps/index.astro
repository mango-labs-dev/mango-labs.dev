---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AppCard from '~/components/AppCard.astro';

const apps = await getCollection('apps');
const sorted = apps.sort((a, b) => a.data.order - b.data.order);

const groups = [
  {
    key: 'released',
    title: 'Released',
    note: null,
    apps: sorted.filter((a) => a.data.status === 'released'),
  },
  {
    key: 'beta',
    title: 'In open beta',
    note: 'Public testing — anyone can install via the Play Store beta opt-in.',
    apps: sorted.filter((a) => a.data.status === 'beta'),
  },
  {
    key: 'closed',
    title: 'In closed testing',
    note: 'Invite-only builds on a closed track while we gather feedback. Open release follows once it settles.',
    apps: sorted.filter((a) => a.data.status === 'closed'),
  },
  {
    key: 'internal',
    title: 'In internal testing',
    note: 'Closed builds going out to a small group. Public release follows once the feedback settles.',
    apps: sorted.filter((a) => a.data.status === 'internal'),
  },
  {
    key: 'upcoming',
    title: 'In the kitchen',
    note: 'In development. Pages exist so we can polish copy and design ahead of launch — Play Store links arrive as each one ships.',
    apps: sorted.filter((a) => a.data.status === 'upcoming'),
  },
].filter((g) => g.apps.length > 0);
---

<BaseLayout
  title="Apps"
  description="Every app Mango Labs has shipped — and the ones we're working on next."
>
  <section class="container-page page-head">
    <span class="kicker">The lineup</span>
    <h1>Our apps.</h1>
    <p>
      A small, growing collection. Some are shipping; some are warming up
      backstage. Each one started because we wanted to use it ourselves.
    </p>
  </section>

  <section class="container-page page-body">
    {groups.map((group) => (
      <div class="app-group" id={group.key}>
        <header class="group-head">
          <h2 class="group-title">{group.title}</h2>
          <span class="group-count">{group.apps.length}</span>
        </header>
        {group.note && <p class="group-note">{group.note}</p>}
        <div class="apps-grid">
          {group.apps.map((app) => <AppCard app={app} />)}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: 4.5rem 2.5rem;
    max-width: 48rem;
  }

  .kicker {
    display: inline-block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
    margin-bottom: 0.75rem;
  }

  .page-head h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0 0 1.25rem;
    letter-spacing: -0.035em;
  }

  .page-head p {
    font-size: 1.15rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin: 0;
  }

  .page-body {
    padding-bottom: 5rem;
  }

  .app-group {
    margin-top: 3.5rem;
  }

  .app-group:first-child {
    margin-top: 0;
  }

  .group-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .group-title {
    font-size: 1.6rem;
    font-weight: 500;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .group-count {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--fg-muted);
  }

  .group-note {
    color: var(--fg-muted);
    margin: 0 0 1.5rem;
    max-width: 44rem;
    line-height: 1.6;
  }

  .apps-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .apps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .apps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
