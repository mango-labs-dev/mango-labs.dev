---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/site.config';

// Static override for Sudoku Zen's privacy policy. The dynamic
// `[slug].astro` template still serves every other app; Astro routes
// static files ahead of dynamic ones, so only Sudoku Zen gets this
// bespoke page. See `~/projects/research-data/docs/mango-labs/
// 2026-05-31_adding-app-to-website.md` (Step 3, Option A) for the
// pattern and decision tree.
const apps = await getCollection('apps');
const app = apps.find((a) => a.id === 'sudoku-zen');
if (!app) {
  throw new Error('sudoku-zen app entry not found in src/content/apps');
}
const { name, supportEmail, policyUpdatedAt, accentColor } = app.data;
const contactEmail = supportEmail ?? site.supportEmail;

const lastUpdated = (policyUpdatedAt ?? new Date('2026-06-01')).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${name} — Privacy Policy`}
  description={`The privacy policy for the ${name} Android app by Mango Labs.`}
  accentColor={accentColor}
>
  <section class="container-page page">
    <a href={`/apps/${app.id}`} class="breadcrumb">← Back to {name}</a>

    <header class="page-head">
      <h1>Privacy Policy</h1>
      <p class="for-app">For the <strong>{name}</strong> Android app by Mango Labs.</p>
      <p class="updated">Last updated: {lastUpdated}</p>
    </header>

    <div class="short-version card">
      <p class="short-kicker">THE SHORT VERSION</p>
      <div class="short-grid">
        <div class="short-item">
          <strong>We collect nothing personal.</strong>
          <span>No account, no login, no name or email to play.</span>
        </div>
        <div class="short-item">
          <strong>Your data stays on-device.</strong>
          <span>Progress and settings live on your phone — not our servers.</span>
        </div>
        <div class="short-item">
          <strong>No third-party trackers.</strong>
          <span>No analytics (like GA or Firebase). No fingerprinting.</span>
        </div>
        <div class="short-item">
          <strong>You're always in control.</strong>
          <span>Clear all app data from device settings — gone for good.</span>
        </div>
      </div>
    </div>

    <div class="prose">
      <h2>Short version</h2>
      <p>
        <strong>{name}</strong> does not collect, store, or transmit any personal data.
        The app runs entirely on your device — it has no network access, no accounts,
        no analytics, no advertising, and no third-party services tracking what you do.
      </p>

      <h2>What we don't do</h2>
      <ul>
        <li>We do not collect personally identifiable information.</li>
        <li>We do not require an account.</li>
        <li>We do not use analytics or crash-reporting services.</li>
        <li>We do not show ads.</li>
        <li>We do not sell, rent, or share data with third parties.</li>
      </ul>

      <h2>Data stored on your device</h2>
      <p>
        {name} stores your saved games, statistics, streaks, settings, and
        practice-puzzle progress locally on your device using Android's standard
        local storage. None of this data ever leaves your device — the app cannot
        reach the network.
      </p>
      <p>
        {name} explicitly opts out of Android's auto-backup
        (<code>android:allowBackup="false"</code> in the app manifest), so no
        copy of your game data is ever uploaded to Google Drive on your behalf.
        Uninstalling the app removes everything.
      </p>

      <h2>Permissions</h2>
      <p>
        {name} requests two Android permissions, and only to deliver the optional
        play reminders you can turn on in Settings:
      </p>
      <ul>
        <li>
          <strong>Notifications</strong> (<code>POST_NOTIFICATIONS</code>, Android 13+)
          — to show the reminder. Requested only when you enable reminders; you can
          decline or revoke it at any time.
        </li>
        <li>
          <strong>Run at startup</strong> (<code>RECEIVE_BOOT_COMPLETED</code>) — so a
          reminder you've scheduled still fires after your device restarts.
        </li>
      </ul>
      <p>
        Reminders are scheduled and shown entirely on your device; the suggested
        reminder time is based on when you usually play, computed locally and never
        sent anywhere. {name} still has <strong>no internet or network access</strong>,
        no <code>INTERNET</code> permission, and cannot reach your storage outside its
        own sandbox, your contacts, camera, microphone, or location.
      </p>

      <h2>Children's privacy</h2>
      <p>
        {name} is intended for users aged 18 and over. Because we do not collect
        any personal information from anyone, no special handling for children's
        data is required — there is no data to handle.
      </p>

      <h2>Your rights</h2>
      <p>
        Because {name} does not collect or transmit personal data, there is no
        information held by Mango Labs that we could provide, correct, or delete on
        request. The data inside the app on your device is fully under your control:
        you can change settings, reset statistics, or remove everything by clearing
        the app's storage from Android Settings or by uninstalling. The EU General
        Data Protection Regulation (GDPR), the California Consumer Privacy Act
        (CCPA), and India's Digital Personal Data Protection Act 2023 (DPDP) all
        have nothing to act on, because no data is collected or processed by
        Mango Labs in the first place.
      </p>

      <h2>Changes to this policy</h2>
      <p>
        If we change how {name} handles data — for example, if a future feature
        introduces optional sync — this policy will be updated with a new
        "Last updated" date and the change will be noted in the app's release notes.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about privacy in {name}?
        Email <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: 3rem 4rem;
  }

  .breadcrumb {
    display: inline-block;
    color: var(--sub);
    font-size: 0.9rem;
    margin-bottom: 2rem;
    transition: color 0.15s ease;
  }

  .breadcrumb:hover {
    color: var(--mango-deep);
  }

  .page-head h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 0.75rem;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
  }

  .for-app {
    font-size: 1.05rem;
    color: var(--sub);
    margin: 0 0 0.25rem;
  }

  .for-app strong {
    color: var(--ink);
  }

  .updated {
    font-size: 0.85rem;
    color: var(--sub);
    margin: 0 0 2rem;
  }

  .short-version {
    margin-bottom: 2.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: 20px;
    background: #fff;
  }

  .short-kicker {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage);
    margin: 0 0 1.25rem;
  }

  .short-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .short-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .short-item strong {
    display: block;
    font-size: 0.9rem;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    margin-bottom: 0.25rem;
    color: var(--ink);
  }

  .short-item span {
    display: block;
    font-size: 0.85rem;
    color: var(--sub);
    line-height: 1.55;
  }

  .prose {
    font-size: 1rem;
    line-height: 1.7;
  }

  .prose h2 {
    font-size: 1.25rem;
    margin: 2.5rem 0 0.75rem;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
  }

  .prose p,
  .prose ul {
    margin: 0 0 1.25rem;
  }

  .prose ul {
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.4rem;
  }

  .prose strong {
    color: var(--ink);
  }

  .prose a {
    color: var(--mango-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
</style>
