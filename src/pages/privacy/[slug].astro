---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/site.config';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { slug: app.id },
    props: { app },
  }));
}

const { app } = Astro.props;
const { name, supportEmail, policyUpdatedAt, accentColor } = app.data;
const contactEmail = supportEmail ?? site.supportEmail;

const TEMPLATE_LAST_REVIEWED = new Date('2026-05-31');
const lastUpdated = (policyUpdatedAt ?? TEMPLATE_LAST_REVIEWED).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${name} — Privacy Policy`}
  description={`The privacy policy for the ${name} Android app by Mango Labs.`}
  accentColor={accentColor}
>
  <section class="container-page page">
    <a href={`/apps/${app.id}`} class="breadcrumb">← Back to {name}</a>

    <header class="page-head">
      <h1>Privacy Policy</h1>
      <p class="for-app">For the <strong>{name}</strong> Android app by Mango Labs.</p>
      <p class="updated">Last updated: {lastUpdated}</p>
    </header>

    <div class="short-version card">
      <p class="short-kicker">THE SHORT VERSION</p>
      <div class="short-grid">
        <div class="short-item">
          <strong>We collect nothing personal.</strong>
          <span>No account, no login, no name or email to play.</span>
        </div>
        <div class="short-item">
          <strong>Your data stays on-device.</strong>
          <span>Progress and settings live on your phone — not our servers.</span>
        </div>
        <div class="short-item">
          <strong>No third-party trackers.</strong>
          <span>No analytics (like GA or Firebase). No fingerprinting.</span>
        </div>
        <div class="short-item">
          <strong>You're always in control.</strong>
          <span>Clear all app data directly from device settings — gone for good.</span>
        </div>
      </div>
    </div>

    <div class="prose">
      <h2>Short version</h2>
      <p>
        <strong>{name}</strong> does not collect, store, or transmit any personal data.
        Everything lives on your device. There are no accounts, no analytics, no
        advertising SDKs, and no third-party services tracking what you do.
      </p>

      <h2>What we don't do</h2>
      <ul>
        <li>We do not collect personally identifiable information.</li>
        <li>We do not require an account.</li>
        <li>We do not use analytics or crash-reporting services.</li>
        <li>We do not show ads.</li>
        <li>We do not sell, rent, or share data with third parties.</li>
      </ul>

      <h2>Data stored on your device</h2>
      <p>
        Any content you create in {name} — notes, settings, preferences,
        progress — is stored locally on your device. Uninstalling the app removes
        this data unless you've explicitly backed it up using Android's standard
        backup mechanisms or your own export.
      </p>

      <h2>Permissions</h2>
      <p>
        {name} only requests permissions that are required for features it offers.
        Each permission is used solely for the feature it enables and is never
        sent off-device.
      </p>

      <h2>Children's privacy</h2>
      <p>
        {name} is suitable for general audiences. Because we don't collect any
        personal information, no special handling for children's data is
        required — there is no data to handle.
      </p>

      <h2>Changes to this policy</h2>
      <p>
        If we change how {name} handles data — for example, if a future feature
        introduces optional sync — this policy will be updated with a new
        "Last updated" date and the change will be noted in the app's release
        notes.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about privacy in {name}?
        Email <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: 3rem 4rem;
  }

  .breadcrumb {
    display: inline-block;
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .breadcrumb:hover {
    color: var(--app-accent);
  }

  .page-head h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 0.75rem;
  }

  .for-app {
    font-size: 1.05rem;
    color: var(--fg-muted);
    margin: 0 0 0.25rem;
  }

  .for-app strong {
    color: var(--fg);
  }

  .updated {
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin: 0 0 2rem;
  }

  .short-version {
    margin-bottom: 2.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: 1.25rem;
  }

  .short-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.25rem;
  }

  .short-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .short-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .short-item strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: var(--fg);
  }

  .short-item span {
    display: block;
    font-size: 0.85rem;
    color: var(--fg-muted);
    line-height: 1.55;
  }

  .prose {
    font-size: 1rem;
    line-height: 1.7;
  }

  .prose h2 {
    font-size: 1.25rem;
    margin: 2.5rem 0 0.75rem;
  }

  .prose p,
  .prose ul {
    margin: 0 0 1.25rem;
  }

  .prose ul {
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.4rem;
  }

  .prose strong {
    color: var(--fg);
  }

  .prose a {
    color: var(--app-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
</style>
