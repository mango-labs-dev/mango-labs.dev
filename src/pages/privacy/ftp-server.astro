---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/site.config';

// Static override for FTP Server's privacy policy. Unlike most Mango Labs
// apps, FTP Server is a network file server that shows ads and uses
// Firebase, so the generic "no data, no network" template in
// `[slug].astro` would be untrue here — this bespoke page discloses the
// All Files Access permission, the foreground service, and the
// AdMob / Firebase Analytics / Crashlytics SDKs. Astro routes static
// files ahead of dynamic ones, so only FTP Server gets this page. See
// `~/projects/research-data/docs/mango-labs/
// 2026-05-31_adding-app-to-website.md` (Step 3, Option A) for the pattern.
const apps = await getCollection('apps');
const app = apps.find((a) => a.id === 'ftp-server');
if (!app) {
  throw new Error('ftp-server app entry not found in src/content/apps');
}
const { name, supportEmail, policyUpdatedAt, accentColor } = app.data;
const contactEmail = supportEmail ?? site.supportEmail;

const lastUpdated = (policyUpdatedAt ?? new Date('2026-06-21')).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${name} — Privacy Policy`}
  description={`The privacy policy for the ${name} Android app by Mango Labs.`}
  accentColor={accentColor}
>
  <section class="container-page page">
    <a href={`/apps/${app.id}`} class="breadcrumb">← Back to {name}</a>

    <header class="page-head">
      <h1>Privacy Policy</h1>
      <p class="for-app">For the <strong>{name}</strong> Android app by Mango Labs.</p>
      <p class="updated">Last updated: {lastUpdated}</p>
    </header>

    <div class="short-version card">
      <p class="short-kicker">THE SHORT VERSION</p>
      <div class="short-grid">
        <div class="short-item">
          <strong>Your files stay on your network.</strong>
          <span>Transfers go directly between your devices — never through our servers.</span>
        </div>
        <div class="short-item">
          <strong>Ads are served by Google AdMob.</strong>
          <span>AdMob may show personalized ads using device identifiers.</span>
        </div>
        <div class="short-item">
          <strong>Crash data only.</strong>
          <span>Firebase Crashlytics sends anonymous crash reports — no file names or content.</span>
        </div>
        <div class="short-item">
          <strong>You control access.</strong>
          <span>FTP requires your explicit start. Stop the server anytime.</span>
        </div>
      </div>
    </div>

    <div class="prose">
      <h2>Short version</h2>
      <p>
        <strong>{name}</strong> turns your phone into a file server on your local
        network. The files you share are transferred <strong>directly between your
        own devices</strong> over your network — they are never uploaded to, routed
        through, or stored on Mango Labs servers. We have no account system and no
        way to see your files. The app does, however, show ads and use Google's
        Firebase tools, which collect limited technical data as described below.
      </p>

      <h2>How the file server handles your files</h2>
      <ul>
        <li>
          When you start the server, your phone listens for FTP connections on your
          local network. Other devices on the <strong>same network</strong> can then
          browse and transfer the files in the folder you choose to share.
        </li>
        <li>
          All transfers happen <strong>device-to-device on your own network</strong>.
          Mango Labs never receives, sees, or stores the files you serve or their
          names.
        </li>
        <li>
          Standard FTP is <strong>not encrypted</strong>. Anyone with access to your
          network could, in principle, observe a transfer. Only run the server on
          networks you trust, and set a password (rather than anonymous access) on
          shared or public Wi-Fi.
        </li>
      </ul>

      <h2>Permissions</h2>
      <p>
        {name} requests the permissions it needs to act as a file server. Each is
        used only for the feature it enables:
      </p>
      <ul>
        <li>
          <strong>All files access</strong> (<code>MANAGE_EXTERNAL_STORAGE</code>) —
          so the server can read and write the folders you choose to share. The app
          only exposes files over your local network at your request; this access is
          never used to send your files to us or any third party.
        </li>
        <li>
          <strong>Network access</strong> (<code>INTERNET</code>,
          <code>ACCESS_NETWORK_STATE</code>) — to run the server socket, detect
          whether you're on Wi-Fi or mobile data, and to load ads.
        </li>
        <li>
          <strong>Foreground service</strong> (<code>FOREGROUND_SERVICE</code>,
          <code>FOREGROUND_SERVICE_SPECIAL_USE</code>) and
          <strong>wake lock</strong> (<code>WAKE_LOCK</code>) — so the server keeps
          running, with a visible notification, while you switch apps or your screen
          is off.
        </li>
        <li>
          <strong>Notifications</strong> (<code>POST_NOTIFICATIONS</code>, Android
          13+) — to show the persistent "server running" notification with its stop
          control. You can decline or revoke it at any time.
        </li>
      </ul>

      <h2>Ads and analytics</h2>
      <p>
        {name} is free and supported by ads. To show ads and to keep the app
        reliable, it includes the following Google services, which collect limited
        data on their own terms — not for Mango Labs:
      </p>
      <ul>
        <li>
          <strong>Google AdMob</strong> — displays the banner ad in the app and may
          collect a device advertising identifier and similar data to serve and
          measure ads. See
          <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener"
            >Google's advertising policy</a>. You can reset or limit your advertising
          ID in your device's Google settings.
        </li>
        <li>
          <strong>Firebase Analytics</strong> — collects anonymous, aggregated usage
          statistics (such as app opens and feature use) to help us understand how
          the app is used.
        </li>
        <li>
          <strong>Firebase Crashlytics</strong> — collects crash reports and
          diagnostic data when the app crashes, so we can fix bugs. These reports do
          not include your files or their names.
        </li>
      </ul>
      <p>
        This data is processed by Google under its
        <a href="https://policies.google.com/privacy" target="_blank" rel="noopener"
          >privacy policy</a>. We do not sell your data, and we do not combine it
        with the files you serve — the file server and these services are entirely
        separate.
      </p>

      <h2>Data stored on your device</h2>
      <p>
        Your settings — the port, the optional password, the shared folder, and your
        preferences — are stored locally on your device using Android's standard
        local storage. They are never sent to Mango Labs.
      </p>
      <p>
        The password you set is used only by the server on your device to
        authenticate incoming FTP connections. {name} explicitly opts out of
        Android's auto-backup (<code>android:allowBackup="false"</code> in the app
        manifest), so your settings and password are never uploaded to Google Drive
        on your behalf. Uninstalling the app removes its local data.
      </p>

      <h2>Children's privacy</h2>
      <p>
        {name} is a general-purpose utility intended for users aged 13 and over and
        is not directed at children. Because it serves ads, we ask younger users to
        seek a parent or guardian's permission before use.
      </p>

      <h2>Your rights</h2>
      <p>
        Mango Labs does not hold an account or a profile for you — the files you
        serve never reach us, so there is nothing on our side to export or delete.
        The settings inside the app are under your control: change them in the app,
        or clear the app's storage from Android Settings or uninstall to remove
        everything. For the ad and analytics data processed by Google, you can
        exercise your rights under the EU General Data Protection Regulation (GDPR),
        the California Consumer Privacy Act (CCPA), and India's Digital Personal Data
        Protection Act 2023 (DPDP) through your device's Google settings and Google's
        own privacy controls, or contact us and we'll help where we can.
      </p>

      <h2>Changes to this policy</h2>
      <p>
        If we change how {name} handles data — for example, if a future feature adds
        encrypted transfers or removes ads — this policy will be updated with a new
        "Last updated" date and the change will be noted in the app's release notes.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about privacy in {name}?
        Email <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: 3rem 4rem;
  }

  .breadcrumb {
    display: inline-block;
    color: var(--sub);
    font-size: 0.9rem;
    margin-bottom: 2rem;
    transition: color 0.15s ease;
  }

  .breadcrumb:hover {
    color: var(--mango-deep);
  }

  .page-head h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 0.75rem;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
  }

  .short-version {
    margin-bottom: 2.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: 20px;
    background: #fff;
  }

  .short-kicker {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage);
    margin: 0 0 1.25rem;
  }

  .short-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .short-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .short-item strong {
    display: block;
    font-size: 0.9rem;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    margin-bottom: 0.25rem;
    color: var(--ink);
  }

  .short-item span {
    display: block;
    font-size: 0.85rem;
    color: var(--sub);
    line-height: 1.55;
  }

  .for-app {
    font-size: 1.05rem;
    color: var(--sub);
    margin: 0 0 0.25rem;
  }

  .for-app strong {
    color: var(--ink);
  }

  .updated {
    font-size: 0.85rem;
    color: var(--sub);
    margin: 0 0 2rem;
  }

  .prose {
    font-size: 1rem;
    line-height: 1.7;
  }

  .prose h2 {
    font-size: 1.25rem;
    margin: 2.5rem 0 0.75rem;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
  }

  .prose p,
  .prose ul {
    margin: 0 0 1.25rem;
  }

  .prose ul {
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.4rem;
  }

  .prose strong {
    color: var(--ink);
  }

  .prose a {
    color: var(--mango-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
</style>
