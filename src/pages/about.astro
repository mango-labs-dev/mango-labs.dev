---
import { Icon } from 'astro-icon/components';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/site.config';
---

<BaseLayout
  title="About"
  description="Mango Labs is a small Android studio focused on calm, well-built apps."
>
  <section class="container-page page">
    <header class="page-head">
      <h1>About Mango Labs</h1>
      <p class="lede">
        A small studio making calm, well-built Android apps — one at a time.
      </p>
    </header>

    <div class="prose">
      <p>
        Mango Labs started for a simple reason: most apps try too hard. They beg
        for attention, hold data hostage, push notifications you didn't ask for.
        We wanted to make the opposite — small apps that respect your time,
        live on your device, and don't try to become your whole life.
      </p>

      <h2>How we work</h2>
      <p>
        Every app gets the time it needs. Nothing ships until it feels right —
        not until it hits a sprint deadline. That sometimes means an app sits
        in development for months while we get one interaction right.
      </p>

      <h2>What you can count on</h2>
      <ul>
        <li><strong>No accounts.</strong> Your phone is the source of truth.</li>
        <li><strong>No ads.</strong> Ever. Free apps stay free because they're small.</li>
        <li><strong>No trackers.</strong> Nothing phones home.</li>
        <li><strong>Your data is yours.</strong> Export it, take it elsewhere, delete it. Anytime.</li>
      </ul>

      <h2>Get in touch</h2>
      <p>
        Bug? Idea? Just want to say hi?
        <a href={`mailto:${site.email}`}>{site.email}</a> — we read everything.
      </p>
    </div>

    <div class="links">
      <a href={site.social.github} class="link-card" target="_blank" rel="noopener">
        <Icon name="simple-icons:github" />
        <div>
          <span class="link-label">GitHub</span>
          <span class="link-sub">Some of our code lives in the open</span>
        </div>
      </a>
      <a href={site.social.playStoreDeveloper} class="link-card" target="_blank" rel="noopener">
        <Icon name="simple-icons:googleplay" />
        <div>
          <span class="link-label">Google Play</span>
          <span class="link-sub">Find every app we've published</span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: 4rem;
    max-width: 42rem;
  }

  .page-head {
    margin-bottom: 2.5rem;
  }

  .page-head h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin: 0 0 1rem;
  }

  .lede {
    font-size: 1.2rem;
    color: var(--fg-muted);
    line-height: 1.55;
    margin: 0;
  }

  .prose {
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .prose h2 {
    font-size: 1.5rem;
    margin: 2.5rem 0 1rem;
  }

  .prose p,
  .prose ul {
    margin: 0 0 1.25rem;
  }

  .prose ul {
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose strong {
    color: var(--fg);
  }

  .prose a {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .links {
    margin-top: 3rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .link-card {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--bg-elevated);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .link-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .link-card :global(svg) {
    width: 28px;
    height: 28px;
    color: var(--fg-muted);
  }

  .link-card:hover :global(svg) {
    color: var(--accent);
  }

  .link-label {
    display: block;
    font-weight: 500;
  }

  .link-sub {
    display: block;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
</style>
