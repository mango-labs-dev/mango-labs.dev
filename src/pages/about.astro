---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/site.config';
---

<BaseLayout
  title="About"
  description="Mango Labs is a small Android studio focused on calm, well-built apps."
>
  <div class="container-page">
    <section class="hero">
      <span class="eyebrow">About</span>
      <h1 class="headline">
        A small studio making calm,<br />well-built Android apps — one at a time.
      </h1>
      <p class="lede">
        Mango Labs started for a simple reason: most apps try too hard. They beg for attention,
        hold data hostage, push notifications you didn't ask for. We wanted to make the opposite —
        small apps that respect your time, live on your device, and don't try to become your whole life.
      </p>
    </section>

    <section class="section">
      <h2 class="headline">How we work</h2>
      <p class="section-p">
        Every app gets the time it needs. Nothing ships until it feels right — not until it hits a
        sprint deadline. That sometimes means an app sits in development for months while we get
        one interaction right.
      </p>
    </section>

    <section class="section">
      <h2 class="headline">What you can count on</h2>
      <div class="checks">
        <div class="check">
          <div class="check-dot" aria-hidden="true"></div>
          <div>
            <strong class="headline">No accounts.</strong>
            <span>Your phone is the source of truth.</span>
          </div>
        </div>
        <div class="check">
          <div class="check-dot" aria-hidden="true"></div>
          <div>
            <strong class="headline">No ads.</strong>
            <span>Ever. Free apps stay free because they're small.</span>
          </div>
        </div>
        <div class="check">
          <div class="check-dot" aria-hidden="true"></div>
          <div>
            <strong class="headline">No trackers.</strong>
            <span>Nothing phones home.</span>
          </div>
        </div>
        <div class="check">
          <div class="check-dot" aria-hidden="true"></div>
          <div>
            <strong class="headline">Your data is yours.</strong>
            <span>Export it, take it elsewhere, delete it. Anytime.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="headline">Get in touch</h2>
      <p class="section-p">Bug? Idea? Just want to say hi? We read everything.</p>
      <div class="touch-row">
        <a href={`mailto:${site.email}`} class="touch-card">
          <strong class="headline">Email us</strong>
          <span>{site.email}</span>
        </a>
        <a href={site.social.playStoreDeveloper} class="touch-card" target="_blank" rel="noopener">
          <strong class="headline">Google Play</strong>
          <span>Find every app we've published</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 40px 0 8px;
    max-width: 680px;
  }

  .hero .eyebrow {
    display: block;
    margin-bottom: 12px;
  }

  .hero h1 {
    font-size: clamp(2rem, 4vw, 52px);
    line-height: 1.08;
    margin: 10px 0 20px;
    letter-spacing: -0.01em;
  }

  .lede {
    font-size: 18px;
    color: var(--sub);
    line-height: 1.6;
    margin: 0;
  }

  .section {
    padding: 40px 0;
    max-width: 680px;
  }

  .section h2 {
    font-size: 24px;
    margin: 0 0 14px;
  }

  .section-p {
    font-size: 16px;
    color: var(--sub);
    line-height: 1.65;
    margin: 0;
  }

  .checks {
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    margin-top: 8px;
  }

  .check {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 20px 24px;
    border-bottom: 1px solid var(--line);
  }

  .check:last-child {
    border-bottom: none;
  }

  .check-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--sage);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .check strong {
    font-size: 16px;
    display: block;
    margin-bottom: 2px;
    color: var(--ink);
  }

  .check span {
    color: var(--sub);
    font-size: 14.5px;
  }

  .touch-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .touch-card {
    background: #fff;
    border-radius: 16px;
    padding: 18px 22px;
    flex: 1;
    min-width: 180px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--ink);
    transition: transform 0.15s ease;
  }

  .touch-card:hover {
    transform: translateY(-2px);
  }

  .touch-card strong {
    font-size: 15px;
    display: block;
  }

  .touch-card span {
    color: var(--sub);
    font-size: 13.5px;
  }

  .container-page {
    padding-bottom: 4rem;
  }
</style>
