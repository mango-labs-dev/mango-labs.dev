---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AppCard from '~/components/AppCard.astro';

const apps = await getCollection('apps');
const sorted = apps.sort((a, b) => a.data.order - b.data.order);
const totalApps = apps.length;
const lineupApps = sorted.slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-left">
        <span class="eyebrow">From the lab</span>
        <h1 class="hero-title headline">Apps that<br />don't shout.</h1>
      </div>
      <div class="hero-right">
        <p class="hero-sub">
          A small, growing lineup of Android apps built to stay out of your way.
          No trackers, no noise — just the good stuff.
        </p>
        <div class="cta-row">
          <a href="/apps" class="btn btn-primary">Browse apps</a>
          <a href="/about" class="btn btn-ghost">Our approach →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="tags-section">
    <div class="tag-chip">
      <span class="pill-num">01</span>
      Calm by default
    </div>
    <div class="tag-chip">
      <span class="pill-num">02</span>
      Does less, on purpose
    </div>
    <div class="tag-chip">
      <span class="pill-num">03</span>
      Crafted, not assembled
    </div>
  </section>

  <section class="lineup">
    <div class="lineup-head">
      <h2 class="headline">The lineup</h2>
      <a href="/apps" class="lineup-all">All {totalApps} →</a>
    </div>
    <div class="lineup-strip">
      {lineupApps.map((app) => <AppCard app={app} />)}
    </div>
  </section>

  <section class="privacy-band">
    <h2 class="headline">Every policy, in plain English.</h2>
    <p>
      A plain-language summary up top, full legalese below —
      exactly what a reviewer or a curious user needs.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 40px 5% 8px;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 40px;
    align-items: end;
  }

  .hero-left .eyebrow {
    display: block;
    margin-bottom: 12px;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 76px);
    line-height: 0.98;
    margin: 10px 0 0;
    letter-spacing: -0.01em;
  }

  .hero-right {
    border-left: 1px solid var(--line);
    padding-left: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-sub {
    font-size: 16px;
    color: var(--sub);
    line-height: 1.6;
    margin: 0;
  }

  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Tag chips */
  .tags-section {
    display: flex;
    gap: 10px;
    padding: 36px 5%;
    flex-wrap: wrap;
  }

  .tag-chip {
    background: #fff;
    border-radius: 99px;
    padding: 10px 18px;
    font-size: 13.5px;
    display: flex;
    gap: 8px;
    align-items: center;
    border: 1px solid var(--line);
    font-weight: 600;
    color: var(--ink);
  }

  .pill-num {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 13px;
    color: var(--mango-deep);
  }

  /* Lineup */
  .lineup {
    padding: 16px 0 56px;
  }

  .lineup-head {
    padding: 0 5%;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 20px;
  }

  .lineup-head h2 {
    font-size: 30px;
    margin: 0;
  }

  .lineup-all {
    font-size: 14px;
    font-weight: 700;
    color: var(--mango-deep);
    transition: color 0.15s ease;
  }

  .lineup-all:hover {
    color: var(--mango);
  }

  .lineup-strip {
    display: flex;
    gap: 20px;
    padding: 0 5%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .lineup-strip::-webkit-scrollbar {
    display: none;
  }

  .lineup-strip > :global(.app-card) {
    flex: 0 0 260px;
  }

  /* Privacy band */
  .privacy-band {
    margin: 8px 5% 56px;
    background: var(--sage);
    color: #fff;
    border-radius: 24px;
    padding: 56px 5%;
  }

  .privacy-band h2 {
    font-size: clamp(1.6rem, 3vw, 36px);
    max-width: 640px;
    margin: 0 0 14px;
    color: #fff;
  }

  .privacy-band p {
    max-width: 480px;
    margin: 0;
    opacity: 0.85;
    font-size: 15px;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-right {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--line);
      padding-top: 20px;
    }

    .hero-title {
      font-size: clamp(2.5rem, 10vw, 64px);
    }
  }
</style>
