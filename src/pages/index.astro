---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AppCard from '~/components/AppCard.astro';

const apps = await getCollection('apps');
const featured = apps
  .filter((a) => a.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const totalApps = apps.length;
---

<BaseLayout>
  <section class="hero">
    <div class="hero-glow hero-glow-a" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-b" aria-hidden="true"></div>

    <div class="container-page hero-inner">
      <span class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        A studio of {totalApps} small Android apps
      </span>

      <h1 class="hero-title">
        Apps you'd actually<br />
        want <em>installed</em>.
      </h1>

      <p class="hero-lede">
        Mango Labs makes quiet, useful Android apps —
        <span class="lede-strong">puzzles to unwind with</span>,
        <span class="lede-strong">utilities that get out of your way</span>,
        <span class="lede-strong">tools that don't try to run your life</span>.
      </p>

      <div class="hero-cta">
        <a href="/apps" class="btn btn-primary">
          See the lineup
          <Icon name="mdi:arrow-right" />
        </a>
        <a href="/about" class="btn btn-ghost">About the studio</a>
      </div>
    </div>

    <div class="hero-marquee" aria-hidden="true">
      {apps.map((a) => (
        <span class="marquee-app" style={`color: ${a.data.accentColor};`}>
          {a.data.name}
        </span>
      ))}
      {apps.map((a) => (
        <span class="marquee-app" style={`color: ${a.data.accentColor};`}>
          {a.data.name}
        </span>
      ))}
    </div>
  </section>

  <section class="container-page featured">
    <header class="section-head">
      <span class="section-kicker">Featured</span>
      <h2>In the spotlight.</h2>
    </header>

    <div class="featured-grid">
      {featured.map((app) => <AppCard app={app} />)}
    </div>

    <div class="featured-footer">
      <a href="/apps" class="featured-link">
        <span>Browse all {totalApps} apps</span>
        <Icon name="mdi:arrow-right" />
      </a>
    </div>
  </section>

  <section class="container-page values">
    <div class="value">
      <div class="value-icon"><Icon name="mdi:weather-sunset" /></div>
      <h3>Calm by default</h3>
      <p>No streaks badgering you to come back. No notifications that aren't earned.</p>
    </div>
    <div class="value">
      <div class="value-icon"><Icon name="mdi:shield-lock-outline" /></div>
      <h3>Your data stays put</h3>
      <p>On-device by default. No accounts, no tracking, no ads.</p>
    </div>
    <div class="value">
      <div class="value-icon"><Icon name="mdi:heart-outline" /></div>
      <h3>Crafted, not assembled</h3>
      <p>Each app does one thing well. Released only when it actually feels right.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 6rem 2rem;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 60rem;
  }

  .hero-glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-glow-a {
    inset: -25% -10% auto auto;
    width: 60vw;
    height: 60vw;
    max-width: 720px;
    max-height: 720px;
    background: radial-gradient(circle at center,
      color-mix(in oklab, var(--color-mango) 65%, transparent) 0%,
      transparent 60%);
    opacity: 0.75;
  }

  .hero-glow-b {
    inset: auto auto -20% -15%;
    width: 45vw;
    height: 45vw;
    max-width: 520px;
    max-height: 520px;
    background: radial-gradient(circle at center,
      color-mix(in oklab, #ff6b1a 55%, transparent) 0%,
      transparent 60%);
    opacity: 0.4;
  }

  :global(.dark) .hero-glow-a { opacity: 0.45; }
  :global(.dark) .hero-glow-b { opacity: 0.25; }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in oklab, var(--accent) 28%, transparent);
  }

  .hero-title {
    margin: 1.5rem 0 1.5rem;
    font-size: clamp(3rem, 8vw, 5.75rem);
    line-height: 0.98;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .hero-title em {
    font-style: italic;
    color: var(--accent);
    font-weight: 400;
  }

  .hero-lede {
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    color: var(--fg-muted);
    line-height: 1.55;
    max-width: 44rem;
    margin: 0 0 2.25rem;
  }

  .lede-strong {
    color: var(--fg);
    font-weight: 500;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-cta .btn :global(svg) {
    width: 18px;
    height: 18px;
  }

  /* Endless marquee of app names in their brand colors below the hero.
     Subtle, decorative — shows the breadth of the catalog at a glance. */
  .hero-marquee {
    margin-top: 3.5rem;
    overflow: hidden;
    border-block: 1px solid var(--border);
    padding-block: 1.25rem;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    position: relative;
    z-index: 1;
    display: flex;
    gap: 3rem;
    white-space: nowrap;
    animation: marquee 40s linear infinite;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .marquee-app {
    display: inline-flex;
    align-items: center;
    gap: 3rem;
  }

  .marquee-app::after {
    content: "✦";
    color: var(--fg-muted);
    margin-left: 3rem;
    font-style: normal;
    font-size: 0.6em;
    opacity: 0.5;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-marquee {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  .featured {
    padding-block: 5rem 3rem;
  }

  .section-head {
    margin-bottom: 2.5rem;
  }

  .section-kicker {
    display: inline-block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
    margin-bottom: 0.5rem;
  }

  .section-head h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0;
    letter-spacing: -0.03em;
  }

  .featured-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .featured-footer {
    margin-top: 2.5rem;
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
    font-weight: 500;
    padding: 0.5rem 0;
    border-bottom: 1px solid color-mix(in oklab, var(--accent) 40%, transparent);
    transition: border-color 0.2s ease, gap 0.2s ease;
  }

  .featured-link:hover {
    border-color: var(--accent);
    gap: 0.85rem;
  }

  .featured-link :global(svg) {
    width: 18px;
    height: 18px;
  }

  .values {
    padding-block: 5rem 4rem;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .values {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .value-icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .value-icon :global(svg) {
    width: 26px;
    height: 26px;
  }

  .value h3 {
    font-size: 1.4rem;
    font-weight: 500;
    margin: 0 0 0.65rem;
    letter-spacing: -0.02em;
  }

  .value p {
    color: var(--fg-muted);
    margin: 0;
    line-height: 1.6;
  }
</style>
