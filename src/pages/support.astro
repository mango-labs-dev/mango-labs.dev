---
import { Icon } from 'astro-icon/components';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/site.config';

const faqs = [
  {
    q: 'Do I need an account?',
    a: 'No. Every Mango Labs app works entirely on your device — no sign-up, no login, no email required.',
  },
  {
    q: "Where's the privacy policy?",
    a: 'Every app has its own plain-language policy. Find it on the app\'s page here on the site, or inside the app under About → Privacy policy.',
  },
  {
    q: 'When does [app] launch?',
    a: 'We ship when it feels right, not when a calendar says so. Keep an eye on the Apps page — status updates there first.',
  },
  {
    q: 'How do I request a feature?',
    a: 'Email or GitHub — both go to the same person. Describe what you\'re trying to do and why. If it fits the app\'s focus, it goes on the list.',
  },
];
---

<BaseLayout
  title="Support"
  description="Get help, report a bug, or share an idea. There's no ticket queue — just a human who built the app."
>
  <section class="container-page page-head">
    <p class="eyebrow">WE CALL QUESTIONS</p>
    <h1>Questions, ideas,<br />bug reports?</h1>
    <p class="lede">
      There's no ticket queue and no bot. Drop us a line and a human —
      usually the person who built the app — will reply.
    </p>
  </section>

  <section class="container-page contact-section">
    <div class="contact-grid">
      <a href={`mailto:${site.supportEmail}`} class="contact-card card">
        <div class="contact-icon">
          <Icon name="mdi:email-outline" />
        </div>
        <div>
          <span class="contact-label">Email us</span>
          <span class="contact-value">{site.supportEmail}</span>
        </div>
      </a>
      <a href={site.social.github} class="contact-card card" target="_blank" rel="noopener">
        <div class="contact-icon">
          <Icon name="simple-icons:github" />
        </div>
        <div>
          <span class="contact-label">Open an issue</span>
          <span class="contact-value">github.com/mango-labs</span>
        </div>
      </a>
    </div>
  </section>

  <section class="container-page faq-section">
    <h2>Common questions</h2>
    <div class="faq-list">
      {faqs.map((item) => (
        <details class="faq-item card">
          <summary class="faq-question">
            {item.q}
            <span class="faq-chevron" aria-hidden="true">
              <Icon name="mdi:chevron-down" />
            </span>
          </summary>
          <p class="faq-answer">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: 4.5rem 2.5rem;
    max-width: 48rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    border: 2px solid var(--ink);
    background: var(--secondary);
    color: var(--color-paper);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .page-head h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0 0 1.25rem;
    line-height: 1.05;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--fg-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 38rem;
  }

  .contact-section {
    padding-bottom: 3rem;
  }

  .contact-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    max-width: 36rem;
  }

  @media (min-width: 640px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    color: var(--fg);
  }

  .contact-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    color: var(--accent);
    flex-shrink: 0;
  }

  .contact-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .contact-label {
    display: block;
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.2rem;
  }

  .contact-value {
    display: block;
    font-size: 0.85rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
  }

  .faq-section {
    padding-bottom: 5rem;
  }

  .faq-section h2 {
    font-size: clamp(1.6rem, 2.5vw, 2.25rem);
    margin: 0 0 1.5rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 48rem;
  }

  .faq-item {
    border-radius: 1rem;
    overflow: visible;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 1rem;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    background: var(--tint);
    color: var(--fg-muted);
    transition: transform 0.2s ease;
  }

  .faq-chevron :global(svg) {
    width: 18px;
    height: 18px;
  }

  details[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.4rem 1.1rem;
    color: var(--fg-muted);
    line-height: 1.65;
    margin: 0;
    font-size: 0.97rem;
  }
</style>
