---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/site.config';

const faqs = [
  {
    q: 'Do I need an account?',
    a: 'No. Every Mango Labs app works entirely on your device — no sign-up, no login, no email required.',
  },
  {
    q: "Where's the privacy policy?",
    a: "Every app has its own plain-language policy. Find it on the app's page here on the site, or inside the app under About → Privacy policy.",
  },
  {
    q: 'When does an app launch?',
    a: "We ship when it feels right, not when a calendar says so. Keep an eye on the Apps page — status updates there first.",
  },
  {
    q: 'How do I request a feature?',
    a: "Email us — describe what you're trying to do and why. If it fits the app's focus, it goes on the list.",
  },
];
---

<BaseLayout
  title="Support"
  description="Get help, report a bug, or share an idea. There's no ticket queue — just a human who built the app."
>
  <div class="container-page">
    <section class="hero">
      <span class="eyebrow">Support</span>
      <h1 class="headline">Questions, ideas, bug reports?</h1>
      <p class="hero-sub">
        There's no ticket queue and no bot. Drop us a line and a human —
        usually the person who built the app — will reply.
      </p>
      <div class="cta-row">
        <a href={`mailto:${site.supportEmail}`} class="btn btn-primary">Email us →</a>
      </div>
    </section>

    <section class="faq-section">
      <h2 class="headline">Common questions</h2>
      <div class="faq">
        {faqs.map((item) => (
          <div class="faq-item">
            <strong class="headline">{item.q}</strong>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 40px 0 8px;
    max-width: 640px;
  }

  .hero .eyebrow {
    display: block;
    margin-bottom: 12px;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 56px);
    line-height: 1.05;
    margin: 10px 0 16px;
    letter-spacing: -0.01em;
  }

  .hero-sub {
    font-size: 17px;
    color: var(--sub);
    line-height: 1.6;
    margin: 0 0 24px;
  }

  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .faq-section {
    padding: 48px 0 80px;
    max-width: 680px;
  }

  .faq-section h2 {
    font-size: 26px;
    margin: 0 0 20px;
  }

  .faq {
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
  }

  .faq-item {
    padding: 22px 26px;
    border-bottom: 1px solid var(--line);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-item strong {
    font-size: 16.5px;
    display: block;
    margin-bottom: 6px;
    color: var(--ink);
  }

  .faq-item p {
    margin: 0;
    color: var(--sub);
    font-size: 14.5px;
    line-height: 1.6;
  }

  .container-page {
    padding-bottom: 2rem;
  }
</style>
